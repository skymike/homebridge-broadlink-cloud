{
  "name": "homebridge-broadlink-cloud",
  "version": "0.3.5",
  "type": "module",
  "description": "Homebridge cloud setup, configurable fan remotes and command buttons for BroadLink RM MAX",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "broadlink",
    "rm-max",
    "homekit",
    "ir",
    "rf",
    "fan",
    "air-conditioner"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "homebridge-ui/",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/configuration.md",
    "docs/ac-controls.md"
  ],
  "engines": {
    "node": ">=22.18.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "homebridge": "^2.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skymike/homebridge-broadlink-cloud.git"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6"
  },
  "author": "skymike",
  "homepage": "https://github.com/skymike/homebridge-broadlink-cloud#readme",
  "bugs": {
    "url": "https://github.com/skymike/homebridge-broadlink-cloud/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
